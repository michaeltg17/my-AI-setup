{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "local": {
      "name": "Local",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://192.168.1.100:9931/v1",
        "headerTimeout": false,
        "chunkTimeout": false
      },
      "models": {
        "Qwen3.8-Flash-Next-IQ3_S": {
          "name": "Qwen3.8-Flash-Next-IQ3_S",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 200000,
            "output": 65536
          }
        }
      }
    }
  },
  "model": "local/Qwen3.8-Flash-Next-IQ3_S",
  "websearch": false,
  "mcp": {
    "servers": {
      "searxng": {
        "type": "local",
        "command": ["mcp-searxng"],
        "environment": {
          "SEARXNG_URL": "http://192.168.1.46:8081",
          "SEARXNG_TIMEOUT_MS": "30000"
        }
      }
    }
  }
}
